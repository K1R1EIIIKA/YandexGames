  m_LocaleId:
    m_Code: tr
  m_SharedData: {fileID: 11400000, guid: 8c8ca9e02e69aec41bb09320851c53d1, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 14239081914425344
    m_Localized: 3D OmNom
    m_Metadata:
      m_Items: []
  - m_Id: 14239082031865856
    m_Localized: "2B'nin zay\u0131flar i\xE7in oldu\u011Funa inan\u0131r. \xC7erezlerin
      i\xE7ini g\xF6r\xFCyor!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239082493239297
    m_Localized: O kadar asidik ki elektrolit onun sabah kokteyli.
    m_Metadata:
      m_Items: []
  - m_Id: 14239082711343105
    m_Localized: "Vergi \xF6demeye \xE7al\u0131\u015F\u0131yor ama her \u015Feyini
      \u015Fekere harc\u0131yor."
    m_Metadata:
      m_Items: []
  - m_Id: 14239082958807041
    m_Localized: Elinizde bir baget, kalbinizde bir kruvasan!
    m_Metadata:
      m_Items: []
  - m_Id: 14239083252408321
    m_Localized: "Daha sonra tatl\u0131 kazanabilmek i\xE7in brokoli yiyor."
    m_Metadata:
      m_Items: []
  - m_Id: 14239083541815297
    m_Localized: "Usta yemek \xE7ubuklar\u0131, kung fu ve gizemli bir g\xFCl\xFCmseme."
    m_Metadata:
      m_Items: []
  - m_Id: 14239083768307713
    m_Localized: "Cicili bicili h\u0131\u015F\u0131rdar ve her zaman bir mandalina
      ta\u015F\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 14239084011577345
    m_Localized: "Amnyam maceradan zevk alan ger\xE7ek bir karakter!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239084275818497
    m_Localized: "\xC7ikolata da\u011F\u0131n\u0131n zirvesinden ba\u015Fkalar\u0131na
      bak\u0131yor."
    m_Metadata:
      m_Items: []
  - m_Id: 14239084565225473
    m_Localized: "Marmelat bo\u011Fas\u0131n\u0131 eyerledi ve inmiyor!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239084821078017
    m_Localized: "Yulaf ezmesini peygamber \xE7i\xE7ekleri ile bile s\xFCsl\xFCyor."
    m_Metadata:
      m_Items: []
  - m_Id: 14239085055959041
    m_Localized: "\u015Euruplar\u0131 kar\u0131\u015Ft\u0131r\u0131p alt\u0131na
      ya da re\xE7ele d\xF6n\xFC\u015Ft\xFCr\xFCyor."
    m_Metadata:
      m_Items: []
  - m_Id: 14239085282451457
    m_Localized: "DemoNyam maceradan zevk alan ger\xE7ek bir karakter!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239085546692609
    m_Localized: "Kurabiyelerini elinden al\u0131rsan alevler sa\xE7ar."
    m_Metadata:
      m_Items: []
  - m_Id: 14239085907402753
    m_Localized: "Tabakta d\xF6n\xFCyor ve soslar hakk\u0131nda felsefe yap\u0131yor."
    m_Metadata:
      m_Items: []
  - m_Id: 14239086138089473
    m_Localized: "\xD6zg\xFCrl\xFCk ve marmelat getirir."
    m_Metadata:
      m_Items: []
  - m_Id: 14239086385553409
    m_Localized: "Berbat ama i\xE7inde bir marshmallow var."
    m_Metadata:
      m_Items: []
  - m_Id: 14239086674960385
    m_Localized: Papatya ve vanilya gibi kokuyor.
    m_Metadata:
      m_Items: []
  - m_Id: 14239086960173057
    m_Localized: "Karamelin sakland\u0131\u011F\u0131 bir yapra\u011F\u0131n alt\u0131nda
      ya\u015Far."
    m_Metadata:
      m_Items: []
  - m_Id: 14239087207636993
    m_Localized: "\xD6zg\xFCr Amnyam maceradan zevk alan ger\xE7ek bir karakter!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239087392186369
    m_Localized: "D\xFC\u011Fmelere o kadar h\u0131zl\u0131 bas\u0131l\u0131yor ki
      \u015Feker eriyip gidiyor."
    m_Metadata:
      m_Items: []
  - m_Id: 14239087631261697
    m_Localized: "Zarif bir \u015Fekilde \xE7ay i\xE7iyor ve hayran\u0131yla d\xFC\u015Fen
      \u015Fekerleri yakal\u0131yor."
    m_Metadata:
      m_Items: []
  - m_Id: 14239087887114241
    m_Localized: "Ba\u015Fka bir seviyede... tatl\u0131l\u0131k."
    m_Metadata:
      m_Items: []
  - m_Id: 14239088159744001
    m_Localized: "Ahududu aromal\u0131 beyinleri se\xE7er."
    m_Metadata:
      m_Items: []
  - m_Id: 14239088419790849
    m_Localized: "Kal\xE7alar\u0131n\u0131n \xFCzerine oturur ve kuru yiyecekleri
      kemirir."
    m_Metadata:
      m_Items: []
  - m_Id: 14239088637894657
    m_Localized: "Turtalar\u0131 sevgiyle ve gizli bir malzeme olan ne\u015Feyle
      pi\u015Firiyor."
    m_Metadata:
      m_Items: []
  - m_Id: 14239088960856065
    m_Localized: "D\xFCnya kurtuldu, art\u0131k \xE7ikolata alabiliyoruz."
    m_Metadata:
      m_Items: []
  - m_Id: 14239089208320001
    m_Localized: "Kulaklar\u0131n\u0131z\u0131 ve dondurman\u0131z\u0131 ayn\u0131
      anda \u0131s\u0131t\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 14239089439006721
    m_Localized: "Kiri sever... \xE7ikolatadan yap\u0131lm\u0131\u015F!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239089715830785
    m_Localized: "D\u0131\u015F\u0131 so\u011Fuk, i\xE7i \xE7ilekli."
    m_Metadata:
      m_Items: []
  - m_Id: 14239089963294721
    m_Localized: "D\u0131\u015F\u0131 so\u011Fuk, i\xE7i \xE7ilekli."
    m_Metadata:
      m_Items: []
  - m_Id: 14239090210758657
    m_Localized: "D\u0131\u015F\u0131 so\u011Fuk, i\xE7i \xE7ilekli."
    m_Metadata:
      m_Items: []
  - m_Id: 14239090470805505
    m_Localized: "'Her zaman a\xE7' modunda g\xFCn\xFCn her saati \xE7al\u0131\u015F\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 14239090701492225
    m_Localized: "Karamel kadar serttir ve zorluklarda k\u0131r\u0131lmaz."
    m_Metadata:
      m_Items: []
  - m_Id: 14239090982510593
    m_Localized: "Kurabiyeleri tek vuru\u015Fta do\u011Frar!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239091284500481
    m_Localized: "Onur i\xE7in sava\u015F\u0131yoruz... ve son lolipop i\xE7in."
    m_Metadata:
      m_Items: []
  - m_Id: 14239091494215681
    m_Localized: "Somun i\xE7in serenatlar s\xF6yl\xFCyor."
    m_Metadata:
      m_Items: []
  - m_Id: 14239091745873921
    m_Localized: "T\xFCm \u015Fark\u0131lar\u0131 bilir, \xF6zellikle de yemekle
      ilgiliyse."
    m_Metadata:
      m_Items: []
  - m_Id: 14239091955589121
    m_Localized: "Bias Amnyam maceradan zevk alan ger\xE7ek bir karakter!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239092215635969
    m_Localized: "\xDCcretsiz Amnyam 2, maceradan zevk alan ger\xE7ek bir karakter!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239092538597377
    m_Localized: "B\xFCy\xFC: Confetus Maximus!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239092794449921
    m_Localized: "Man Face Amnyam maceradan zevk alan ger\xE7ek bir karakter!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239093046108161
    m_Localized: "Gizemli Amnyam... maceradan zevk alan ger\xE7ek bir karakter!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239093331320833
    m_Localized: "'Y\xFCkselin!' diye ba\u011F\u0131r\u0131r tatl\u0131 bir r\xFCyada
      bile."
    m_Metadata:
      m_Items: []
  - m_Id: 14239093624922113
    m_Localized: "M\xFCzik a\u015F\u0131\u011F\u0131 Amnyam, maceradan zevk alan
      ger\xE7ek bir karakter!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239093868191745
    m_Localized: "Mikrobnyam, maceradan zevk alan ger\xE7ek bir karakter!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239094065324033
    m_Localized: "Mim Amnyam maceradan zevk alan ger\xE7ek bir karakter!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239094279233537
    m_Localized: "Mininyam maceradan zevk alan ger\xE7ek bir karakter!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239094551863297
    m_Localized: "Ahududu aromal\u0131 beyinleri se\xE7er."
    m_Metadata:
      m_Items: []
  - m_Id: 14239094837075969
    m_Localized: "Bandajlara sar\u0131l\u0131 ve \u015Fekerlemelere uzan\u0131yor."
    m_Metadata:
      m_Items: []
  - m_Id: 14239095122288641
    m_Localized: "Konoha'dan Amnyam, maceradan zevk alan ger\xE7ek bir karakter!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239095386529793
    m_Localized: "Konserve yiyecek Amnyam, maceradan ho\u015Flanan ger\xE7ek bir
      karakter!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239095642382337
    m_Localized: "Amnyam Ross, maceradan zevk alan ger\xE7ek bir karakter!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239095898234881
    m_Localized: "Firavun Amnyam maceradan zevk alan ger\xE7ek bir karakter!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239096158281729
    m_Localized: "Hazine haritas\u0131 zencefilli kurabiye kutusuna gidiyor!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239096384774145
    m_Localized: "001: \u015Eeker bul. 010: Yemek ye. 011: Tekrar ediyorum."
    m_Metadata:
      m_Items: []
  - m_Id: 14239096682569729
    m_Localized: "Eski stok \u015Fekeri kadar sert."
    m_Metadata:
      m_Items: []
  - m_Id: 14239097030696961
    m_Localized: "Yulaf lapas\u0131 pi\u015Firiyor, \u015Fark\u0131 s\xF6yl\xFCyor
      ve sonra - re\xE7el!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239097257189377
    m_Localized: "Yapraklar\u0131 ve bal\u0131 ayn\u0131 anda yakalar."
    m_Metadata:
      m_Items: []
  - m_Id: 14239097534013441
    m_Localized: "Kum Kral\u0131 Amnyam, maceradan zevk alan ger\xE7ek bir karakter!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239097739534337
    m_Localized: "Kurabiyeleri \xE7ald\u0131m ve bunun bir hata oldu\u011Funu s\xF6yledim."
    m_Metadata:
      m_Items: []
  - m_Id: 14239097986998273
    m_Localized: "Gelece\u011Fi g\xF6r\xFCyor ve i\xE7inde pek \xE7ok tatl\u0131
      \u015Fey var."
    m_Metadata:
      m_Items: []
  - m_Id: 14239098293182465
    m_Localized: "\u015Eekerlerin s\u0131ras\u0131n\u0131 ve miktar\u0131n\u0131
      korur."
    m_Metadata:
      m_Items: []
  - m_Id: 14239098586783745
    m_Localized: "Pamuk \u015Fekeri bile yiyerek uyuyor."
    m_Metadata:
      m_Items: []
  - m_Id: 14239098851024897
    m_Localized: "Karamelin i\xE7inde \u0131\u015F\u0131k h\u0131z\u0131nda s\xFCz\xFCl\xFCyor."
    m_Metadata:
      m_Items: []
  - m_Id: 14239099048157185
    m_Localized: Eriyor, ama sadece marshmallow sevgisinden.
    m_Metadata:
      m_Items: []
  - m_Id: 14239099283038209
    m_Localized: "Re\xE7el bulmak i\xE7in duvarlar boyunca s\xFCr\xFCn\xFCyorum."
    m_Metadata:
      m_Items: []
  - m_Id: 14239099547279361
    m_Localized: "Yeni \xF6\u011Freniyorum ama \u015Fimdiden \xE7ikolata ya\u011Fmuruna
      neden oluyorum!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239099782160385
    m_Localized: "Her turda bir d\xFCzine donut s\u0131k\u0131labilir."
    m_Metadata:
      m_Items: []
  - m_Id: 14239099983486977
    m_Localized: "Tatl\u0131 tutkular\u0131n\u0131n d\xFCnyas\u0131nda bir s\xFCper
      kahraman."
    m_Metadata:
      m_Items: []
  - m_Id: 14239100214173697
    m_Localized: "Kendini pirince \xE7evirir ve wasabi'ye g\xFCl\xFCmser."
    m_Metadata:
      m_Items: []
  - m_Id: 14239100478414849
    m_Localized: "C\u0131z\u0131rd\u0131yor, k\xF6p\xFCr\xFCyor ve limon gibi kokuyor."
    m_Metadata:
      m_Items: []
  - m_Id: 14239100717490177
    m_Localized: "Ekranda sadece yemek pi\u015Firme programlar\u0131 var."
    m_Metadata:
      m_Items: []
  - m_Id: 14239100927205377
    m_Localized: "Tablolar ve keklerle kahvalt\u0131 yap\u0131yor."
    m_Metadata:
      m_Items: []
  - m_Id: 14239101233389569
    m_Localized: "Glug-glug! Bu su de\u011Fil, tatl\u0131 \u015Furup."
    m_Metadata:
      m_Items: []
  - m_Id: 14239101560545281
    m_Localized: "Mikrodalgadaki \u015Feker gibi \u015Fekerle titre\u015Fir."
    m_Metadata:
      m_Items: []
  - m_Id: 14239082493239296
