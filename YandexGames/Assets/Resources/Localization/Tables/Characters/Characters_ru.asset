  - m_Id: 14239100478414848
    m_Localized: "\u0427\u0430\u0439\u043D\u0438\u043A \u0410\u043C\u043D\u044F\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 14239100717490176
    m_Localized: "\u0410\u043C\u043D\u044F\u043C \u0432 \u0442\u0435\u043B\u0435\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 14239100927205376
    m_Localized: "\u0414\u0435\u043B\u043E\u0432\u043E\u0439 \u0410\u043C\u043D\u044F\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 14239101233389568
    m_Localized: "\u0412\u043E\u0434\u043D\u044B\u0439 \u0430\u043C\u043D\u044F\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 14239101560545280
    m_Localized: "\u0410\u043C\u043D\u044F\u043C\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 14239082031865856
    m_Localized: "\u0421\u0447\u0438\u0442\u0430\u0435\u0442, \u0447\u0442\u043E
      2D \u2014 \u044D\u0442\u043E \u0434\u043B\u044F \u0441\u043B\u0430\u0431\u0430\u043A\u043E\u0432.
      \u0412\u0438\u0434\u0438\u0442 \u043F\u0435\u0447\u0435\u043D\u044C\u043A\u0438
      \u043D\u0430\u0441\u043A\u0432\u043E\u0437\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239082493239297
    m_Localized: "\u0422\u0430\u043A\u043E\u0439 \u043A\u0438\u0441\u043B\u044B\u0439,
      \u0447\u0442\u043E \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043B\u0438\u0442
      \u2014 \u0435\u0433\u043E \u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439
      \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 14239082711343105
    m_Localized: "\u041F\u044B\u0442\u0430\u0435\u0442\u0441\u044F \u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u043D\u0430\u043B\u043E\u0433\u0438, \u043D\u043E \u0442\u0440\u0430\u0442\u0438\u0442
      \u0432\u0441\u0451 \u043D\u0430 \u043A\u043E\u043D\u0444\u0435\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 14239082958807041
    m_Localized: "\u0421 \u0431\u0430\u0433\u0435\u0442\u043E\u043C \u0432 \u0440\u0443\u043A\u0435
      \u0438 \u043A\u0440\u0443\u0430\u0441\u0441\u0430\u043D\u043E\u043C \u0432
      \u0441\u0435\u0440\u0434\u0446\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239083541815297
    m_Localized: "\u0412\u043B\u0430\u0434\u0435\u0435\u0442 \u043F\u0430\u043B\u043E\u0447\u043A\u0430\u043C\u0438,
      \u043A\u0443\u043D\u0433-\u0444\u0443 \u0438 \u0437\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u043E\u0439
      \u0443\u043B\u044B\u0431\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 14239083768307713
