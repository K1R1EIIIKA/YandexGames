  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 8c8ca9e02e69aec41bb09320851c53d1, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 14239081914425344
    m_Localized: 3D OmNom
    m_Metadata:
      m_Items: []
  - m_Id: 14239082493239296
    m_Localized: Acid OmNom
    m_Metadata:
      m_Items: []
  - m_Id: 14239082031865856
    m_Localized: Believes that 2D is for weaklings. Sees right through the cookies!
    m_Metadata:
      m_Items: []
  - m_Id: 14239082493239297
    m_Localized: So acidic that electrolyte is his morning cocktail.
    m_Metadata:
      m_Items: []
  - m_Id: 14239082711343105
    m_Localized: Tries to pay taxes, but spends everything on candy.
    m_Metadata:
      m_Items: []
  - m_Id: 14239082958807041
    m_Localized: With a baguette in hand and a croissant in your heart!
    m_Metadata:
      m_Items: []
  - m_Id: 14239083252408321
    m_Localized: He eats broccoli so he can earn dessert later.
    m_Metadata:
      m_Items: []
  - m_Id: 14239083541815297
    m_Localized: Masters chopsticks, kung fu and a mysterious smile.
    m_Metadata:
      m_Items: []
  - m_Id: 14239083768307713
    m_Localized: He rustles with tinsel and always carries a tangerine.
    m_Metadata:
      m_Items: []
  - m_Id: 14239084011577345
    m_Localized: Amnyam is a real character with a taste for adventure!
    m_Metadata:
      m_Items: []
  - m_Id: 14239084275818497
    m_Localized: Looks at others from the top of the chocolate mountain.
    m_Metadata:
      m_Items: []
  - m_Id: 14239084565225473
    m_Localized: "He saddled the marmalade bull and won\u2019t get off!"
    m_Metadata:
      m_Items: []
  - m_Id: 14239084821078017
    m_Localized: It even decorates oatmeal with cornflowers.
    m_Metadata:
      m_Items: []
  - m_Id: 14239085055959041
    m_Localized: Mixes syrups and turns them into gold... or jam.
    m_Metadata:
      m_Items: []
  - m_Id: 14239085282451457
    m_Localized: DemoNyam is a real character with a taste for adventure!
    m_Metadata:
      m_Items: []
  - m_Id: 14239085546692609
    m_Localized: Spits out flames if you take away his cookies.
    m_Metadata:
      m_Items: []
  - m_Id: 14239085907402753
    m_Localized: Spins around in the plate and philosophizes about sauces.
    m_Metadata:
      m_Items: []
  - m_Id: 14239086138089473
    m_Localized: Brings freedom and marmalade.
    m_Metadata:
      m_Items: []
  - m_Id: 14239086385553409
    m_Localized: "Terrible, but inside it\u2019s a marshmallow."
    m_Metadata:
      m_Items: []
  - m_Id: 14239086674960385
    m_Localized: Smells like chamomile and vanilla.
    m_Metadata:
      m_Items: []
  - m_Id: 14239086960173057
    m_Localized: Lives under a leaf where it hides caramel.
    m_Metadata:
      m_Items: []
  - m_Id: 14239087207636993
    m_Localized: Free Amnyam is a real character with a taste for adventure!
    m_Metadata:
      m_Items: []
  - m_Id: 14239087392186369
    m_Localized: Presses the buttons so fast that the sugar melts.
    m_Metadata:
      m_Items: []
  - m_Id: 14239087631261697
    m_Localized: She gracefully drinks tea and catches falling candies with her fan.
    m_Metadata:
      m_Items: []
  - m_Id: 14239087887114241
    m_Localized: Is on another level...sweetness.
    m_Metadata:
      m_Items: []
  - m_Id: 14239088159744001
    m_Localized: Selects brains with raspberry flavor.
    m_Metadata:
      m_Items: []
  - m_Id: 14239088419790849
    m_Localized: Sits on his haunches and gnaws on dry food.
    m_Metadata:
      m_Items: []
  - m_Id: 14239088637894657
    m_Localized: She bakes pies with love and a secret ingredient - joy.
    m_Metadata:
      m_Items: []
  - m_Id: 14239088960856065
    m_Localized: The world has been saved, now we can get some chocolate.
    m_Metadata:
      m_Items: []
  - m_Id: 14239089208320001
    m_Localized: Warms your ears and ice cream at the same time.
    m_Metadata:
      m_Items: []
  - m_Id: 14239089439006721
    m_Localized: Loves dirt... made of chocolate!
    m_Metadata:
      m_Items: []
  - m_Id: 14239089715830785
    m_Localized: Cold on the outside, strawberry on the inside.
    m_Metadata:
      m_Items: []
  - m_Id: 14239089963294721
    m_Localized: Cold on the outside, strawberry on the inside.
    m_Metadata:
      m_Items: []
  - m_Id: 14239090210758657
    m_Localized: Cold on the outside, strawberry on the inside.
    m_Metadata:
      m_Items: []
  - m_Id: 14239090470805505
    m_Localized: Works around the clock in 'always hungry' mode.
    m_Metadata:
      m_Items: []
  - m_Id: 14239090701492225
    m_Localized: Hard as caramel and does not break under difficulties.
    m_Metadata:
      m_Items: []
  - m_Id: 14239090982510593
    m_Localized: Chops cookies with one blow!
    m_Metadata:
      m_Items: []
  - m_Id: 14239091284500481
    m_Localized: Fighting for honor... and for the last piece of candy.
    m_Metadata:
      m_Items: []
  - m_Id: 14239091494215681
    m_Localized: Sings serenades to the loaf.
    m_Metadata:
      m_Items: []
  - m_Id: 14239091745873921
    m_Localized: Knows all the songs, especially if they are about food.
    m_Metadata:
      m_Items: []
  - m_Id: 14239091955589121
    m_Localized: Bias Amnyam is a real character with a taste for adventure!
    m_Metadata:
      m_Items: []
  - m_Id: 14239092215635969
    m_Localized: Free Amnyam 2 is a real character with a taste for adventure!
    m_Metadata:
      m_Items: []
  - m_Id: 14239092538597377
    m_Localized: 'Spell: Confetus Maximus!'
    m_Metadata:
      m_Items: []
  - m_Id: 14239092794449921
    m_Localized: Man Face Amnyam is a real character with a taste for adventure!
    m_Metadata:
      m_Items: []
  - m_Id: 14239093046108161
    m_Localized: Mysterious Amnyam... is a real character with a taste for adventure!
    m_Metadata:
      m_Items: []
  - m_Id: 14239093331320833
    m_Localized: Yells 'Rise!' even in a sweet dream.
    m_Metadata:
      m_Items: []
  - m_Id: 14239093624922113
    m_Localized: Music lover Amnyam is a real character with a taste for adventure!
    m_Metadata:
      m_Items: []
  - m_Id: 14239093868191745
    m_Localized: Mikrobnyam is a real character with a taste for adventure!
    m_Metadata:
      m_Items: []
  - m_Id: 14239094065324033
    m_Localized: Mim Amnyam is a real character with a taste for adventure!
    m_Metadata:
      m_Items: []
  - m_Id: 14239094279233537
    m_Localized: Mininyam is a real character with a taste for adventure!
    m_Metadata:
      m_Items: []
  - m_Id: 14239094551863297
    m_Localized: Selects brains with raspberry flavor.
    m_Metadata:
      m_Items: []
  - m_Id: 14239094837075969
    m_Localized: Wrapped in bandages and reaching for marshmallows.
    m_Metadata:
      m_Items: []
  - m_Id: 14239095122288641
    m_Localized: Amnyam from Konoha is a true character with a taste for adventure!
    m_Metadata:
      m_Items: []
  - m_Id: 14239095386529793
    m_Localized: Canned food Amnyam is a real character with a taste for adventure!
    m_Metadata:
      m_Items: []
  - m_Id: 14239095642382337
    m_Localized: Amnyam Ross is a real character with a taste for adventure!
    m_Metadata:
      m_Items: []
  - m_Id: 14239095898234881
    m_Localized: Pharaoh Amnyam is a real character with a taste for adventure!
    m_Metadata:
      m_Items: []
  - m_Id: 14239096158281729
    m_Localized: The treasure map leads to the gingerbread box!
    m_Metadata:
      m_Items: []
  - m_Id: 14239096384774145
    m_Localized: '001: Find candy. 010: Eat. 011: Repeat.'
    m_Metadata:
      m_Items: []
  - m_Id: 14239096682569729
    m_Localized: Hard as old stock candy.
    m_Metadata:
      m_Items: []
  - m_Id: 14239097030696961
    m_Localized: He cooks porridge, sings ditties, and then - jam!
    m_Metadata:
      m_Items: []
  - m_Id: 14239097257189377
    m_Localized: Catches petals and honey at the same time.
    m_Metadata:
      m_Items: []
  - m_Id: 14239097534013441
    m_Localized: Sand King Amnyam is a true character with a taste for adventure!
    m_Metadata:
      m_Items: []
  - m_Id: 14239097739534337
    m_Localized: I stole cookies and said it was a bug.
    m_Metadata:
      m_Items: []
  - m_Id: 14239097986998273
    m_Localized: He sees the future - and there is a lot of sweet things in it.
    m_Metadata:
      m_Items: []
  - m_Id: 14239098293182465
    m_Localized: Maintains order and quantity of candies.
    m_Metadata:
      m_Items: []
  - m_Id: 14239098586783745
    m_Localized: He even sleeps on cotton candy.
    m_Metadata:
      m_Items: []
  - m_Id: 14239098851024897
    m_Localized: Glides through caramel at the speed of light.
    m_Metadata:
      m_Items: []
  - m_Id: 14239099048157185
    m_Localized: It melts, but only from the love of marshmallows.
    m_Metadata:
      m_Items: []
  - m_Id: 14239099283038209
    m_Localized: Crawling along the walls in search of jam.
    m_Metadata:
      m_Items: []
  - m_Id: 14239099547279361
    m_Localized: Just learning, but already causing chocolate rain!
    m_Metadata:
      m_Items: []
  - m_Id: 14239099782160385
    m_Localized: Can squeeze in a dozen donuts per round.
    m_Metadata:
      m_Items: []
  - m_Id: 14239099983486977
    m_Localized: A superhero in the world of sweet tooths.
    m_Metadata:
      m_Items: []
  - m_Id: 14239100214173697
    m_Localized: Turns himself into rice and smiles at wasabi.
    m_Metadata:
      m_Items: []
  - m_Id: 14239100478414849
    m_Localized: It sizzles, bubbles, and smells of lemon.
    m_Metadata:
      m_Items: []
  - m_Id: 14239100717490177
    m_Localized: There are only cooking shows on the screen.
    m_Metadata:
      m_Items: []
  - m_Id: 14239100927205377
    m_Localized: He has breakfast with charts and muffins.
    m_Metadata:
      m_Items: []
  - m_Id: 14239101233389569
    m_Localized: Glug-glug! This is not water - it's sweet syrup.
    m_Metadata:
      m_Items: []
  - m_Id: 14239101560545281
    m_Localized: Vibrates with sugar like candy in the microwave.
    m_Metadata:
      m_Items: []
