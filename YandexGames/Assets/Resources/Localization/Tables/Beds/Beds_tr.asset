  m_TableData:
  - m_Id: 41799376896
    m_Localized: Sihirli masa
    m_Metadata:
      m_Items: []
  - m_Id: 43812642816
    m_Localized: Normal yatak
    m_Metadata:
      m_Items: []
  - m_Id: 16143197980844032
    m_Localized: "Ye\u015Fil \xFC\xE7gen"
    m_Metadata:
      m_Items: []
  - m_Id: 16143214980358144
    m_Localized: Karpuz
    m_Metadata:
      m_Items: []
  - m_Id: 16143239563173888
    m_Localized: "Bir par\xE7a lambert"
    m_Metadata:
      m_Items: []
  - m_Id: 16143250174763008
    m_Localized: "Sakura'n\u0131n alt\u0131ndaki yatak"
    m_Metadata:
      m_Items: []
  - m_Id: 16143273834831872
    m_Localized: "Buz sal\u0131nca\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 16143316646092800
    m_Localized: "Cehennemin taht\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 16271699216424960
    m_Localized: "Sihir ve s\u0131rlarla dolu bir masa."
    m_Metadata:
      m_Items: []
  - m_Id: 16271740681314304
    m_Localized: "Ger\xE7ek ye\u015Fil sevenler i\xE7in bir do\u011Fa \xFC\xE7geni."
    m_Metadata:
      m_Items: []
  - m_Id: 16271812223557632
    m_Localized: "G\xFCnl\xFCk rahatlama i\xE7in rahat bir yatak."
    m_Metadata:
      m_Items: []
  - m_Id: 16271863893188608
    m_Localized: "Rahat ak\u015Famlar i\xE7in i\u015Ftah a\xE7\u0131c\u0131 bir peynir
      par\xE7as\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 16271909141340160
    m_Localized: "Sulu karpuz \u015Feklindeki yatak bir yaz tatili hayalidir."
    m_Metadata:
      m_Items: []
  - m_Id: 16271934684651520
    m_Localized: "S\u0131cakl\u0131\u011F\u0131 ve konforu sevenler i\xE7in alevli
      bir yatak."
    m_Metadata:
      m_Items: []
  - m_Id: 16271978523516928
    m_Localized: "K\u0131\u015F\u0131n sizi serinleten ferahlat\u0131c\u0131 bir
      yatak."
    m_Metadata:
      m_Items: []
  - m_Id: 16272008244355072
    m_Localized: "Kiraz \xE7i\xE7eklerinden ilham alan narin bir yatak."
    m_Metadata:
      m_Items: []
  references:
    version: 2
